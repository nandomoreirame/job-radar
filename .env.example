# Webhook do canal do Discord onde as vagas serão publicadas.
# Configurações do canal > Integrações > Webhooks > Novo webhook
DISCORD_WEBHOOK_URL=

# Currículo em markdown, com uma seção "## Stack técnica" em tabela.
# É dele que saem as qualificações usadas para casar com a vaga.
PROFILE_PATH=profile/profile.md

# Piso salarial mensal, em reais, por tipo de contrato.
# Só se aplica quando a vaga DECLARA salário (a maioria não declara).
# Vazio ou 0 = não filtrar por salário.
MIN_SALARY_PJ=
MIN_SALARY_CLT=

# Cidades onde uma vaga híbrida é viável para você, separadas por vírgula.
# A comparação é por cidade, não por estado: "São José dos Campos, São Paulo"
# carrega o estado São Paulo e fica a 90 km da capital.
# Vazio = não restringir vagas híbridas por localização.
COMMUTE_CITIES=

# Opcional: eleva o limite de requisições na API do GitHub.
GITHUB_TOKEN=

# Opcional: identifica seu crawler para as fontes.
USER_AGENT=
